# NVIDIA AI Endpoints (Required)
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# LLM & Embeddings Configuration
CHAT_MODEL=meta/llama-3.1-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embed-v1

# Vector Database (Qdrant)
# In Docker Compose, this defaults to the linked qdrant service:
QDRANT_URL=http://qdrant:6333
# For Qdrant Cloud or external server, provide your API key:
QDRANT_API_KEY=
COLLECTION_NAME=docs

# Backend URL used by Streamlit Frontend
BACKEND_URL=http://backend:8000/api

